# Normalize line endings; shell scripts must stay LF even on Windows checkouts.
* text=auto
*.sh text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Fixture bytes are hash-compared against the generator's output in tests;
# no eol conversion may ever touch them (one file is deliberately invalid utf-8).
tests/fixtures/** -text
