# Copy this file to .env and fill in real values. .env is gitignored.

# Required only for the assisted and premium engines. The default local
# engine makes zero API calls, and tests never need it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides. Any config key can be overridden with QUARRY_<SECTION>__<KEY>.
# QUARRY_SEARCH__SEARXNG_URL=http://localhost:8888
# QUARRY_RUN__COST_CAP_USD=5.0
# QUARRY_GPU__VRAM_BUDGET_MB=6656
